local placementRequested = false
local function canBuyFurniture(entry)
    return entry and entry.can_use_in_house and not entry.off_sale and not entry.gamepass and not entry.buy_behavior
end

local function placementEntry(id)
    local entry = catalog[id]
    if canBuyFurniture(entry) then return entry end
    if type(id) ~= "string" or not entry or not entry.model_name then return nil end

    -- Some tutorial items have a normal catalog version of the same model.
    local baseId = id:match("^(.+)_tutorial$")
    local replacement = baseId and catalog[baseId]
    if canBuyFurniture(replacement) and replacement.model_name == entry.model_name then
        return replacement
    end
    return nil
end
local function placeHouse()
    if placing then return end
    placing = true
    local ok, result = pcall(function()
        local sourceHouse = assert(loadedHouse, "Select a file in File System and click Load house from file first.")
        local target = store:getState().house_interior
        assert(target and houseClient.is_current_house_owner() and not houseClient.is_sandbox(),
            "Enter your own house before placing.")
        assert(target.building_type == sourceHouse.building_type,
            "Open your own " .. sourceHouse.building_type .. " house first.")
        assert(not next(target.furniture or {}), "Clear the destination furniture first to avoid duplicates.")
        assert(encode(target.active_addons or {}, {}) == encode(sourceHouse.active_addons or {}, {}),
            "Match the saved house expansions before placing.")

        local requests, textures = {}, {}
        local total = 0
        local function addPrice(entry, id)
            local bucks, alternate = prices.get_cost(entry)
            assert(type(bucks) == "number" and bucks >= 0 and not alternate,
                "No Bucks price for " .. id)
            total += bucks
        end
        for _, item in pairs(sourceHouse.furniture) do
            local entry = placementEntry(item.id)
            assert(entry, "This save contains an item the catalog cannot sell: " .. tostring(item.id) .. ". No purchases were made.")
            assert(typeof(item.cframe) == "CFrame", "Invalid saved position for " .. tostring(item.id))
            addPrice(entry, item.id)
            table.insert(requests, {
                kind = entry.kind,
                properties = {cframe = item.cframe, scale = item.scale, colors = item.colors},
            })
        end
        assert(not target.max_furniture or #requests <= target.max_furniture, "The destination furniture limit is too low.")
        for roomId, room in pairs(sourceHouse.textures or {}) do
            local existing = (target.textures or {})[roomId] or {}
            for kind, id in pairs(room) do
                if existing[kind] ~= id then
                    local entry = texturesCatalog[kind] and texturesCatalog[kind][id]
                    assert(entry and not entry.off_sale and not entry.gamepass, "Cannot purchase texture " .. tostring(id))
                    addPrice(entry, id)
                    table.insert(textures, {roomId, kind, id})
                end
            end
        end

        local function checkDestination()
            local current = store:getState().house_interior
            assert(houseClient.is_current_house_owner() and current and current.house_id == target.house_id,
                "The destination house changed. Placement stopped.")
            return current
        end
        assert((money.get("money") or 0) >= total, string.format("You need %d Bucks to place this layout.", total))
        assert(#requests + #textures > 0, "This layout has nothing to place.")
        local current = checkDestination()
        assert(not next(current.furniture or {}), "The destination furniture changed. Load the file again before placing.")
        assert((money.get("money") or 0) >= total, string.format("You need %d Bucks to place this layout.", total))
        if #requests > 0 then
            checkDestination()
            local response = router.get("HousingAPI/BuyFurnitures"):InvokeServer(requests)
            local placed = 0
            for _, item in pairs(response and response.results or {}) do
                if item.status == "SUCCESS" then placed += 1 end
            end
            assert(response and response.success and placed == #requests,
                string.format("Furniture batch incomplete (%d/%d reported placed). Check your house before trying again.", placed, #requests))
        end
        for index, texture in ipairs(textures) do
            checkDestination()
            pcall(function() scanProgress:Set(string.format("Placement progress: texture %d/%d", index, #textures)) end)
            router.get("HousingAPI/BuyTexture"):FireServer(table.unpack(texture))
            local expires = os.clock() + 5
            while true do
                local current = checkDestination()
                local room = (current.textures or {})[texture[1]]
                if room and room[texture[2]] == texture[3] then break end
                assert(os.clock() < expires, "A texture purchase was not confirmed. Check your house before trying again.")
                task.wait(0.1)
            end
        end
        pcall(function() scanProgress:Set("Placement progress: 100%") end)
        return string.format("Confirmed %d furniture placements and %d texture changes.", #requests, #textures)
    end)
    placing = false
    local title = ok and "Placement complete" or "Placement stopped"
    local message = tostring(result)
    pcall(function() placementStatus:Set({Title = title, Text = message}) end)
    pcall(function() notify(title, message) end)
    if not ok then warn("[Mari Hub] " .. message) end
end

