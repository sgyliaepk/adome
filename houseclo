local function encode(value, active)
    local kind = typeof(value)
    if kind == "string" then return string.format("%q", value) end
    if kind == "boolean" then return tostring(value) end
    if kind == "number" then
        assert(value == value and math.abs(value) < math.huge, "Invalid number")
        return string.format("%.17g", value)
    end
    if kind == "Vector3" or kind == "Color3" or kind == "CFrame" then
        local components
        if kind == "CFrame" then
            components = {value:GetComponents()}
        elseif kind == "Color3" then
            components = {value.R, value.G, value.B}
        else
            components = {value.X, value.Y, value.Z}
        end
        for index, component in ipairs(components) do
            components[index] = encode(component, active)
        end
        return kind .. ".new(" .. table.concat(components, ",") .. ")"
    end
    assert(kind == "table", "Unsupported layout field type: " .. kind)
    assert(not active[value], "Layout contains a circular reference")
    active[value] = true
    local fields = {}
    for key, field in pairs(value) do
        if typeof(field) ~= "Instance" then
            assert(type(key) == "number" or type(key) == "string", "Unsupported layout key")
            table.insert(fields, "[" .. encode(key, active) .. "]=" .. encode(field, active))
        end
    end
    active[value] = nil
    table.sort(fields)
    return "{" .. table.concat(fields, ",") .. "}"
end

