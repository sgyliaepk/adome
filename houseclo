refreshFiles = function()
    local ok, result = pcall(function()
        prepareFolder()
        assert(type(listfiles) == "function", "File listing unavailable")
        local matches = {}
        filePaths = {}
        for _, path in ipairs(listfiles(folder)) do
            local name = path:match("([^/\\]+)$")
            local lower = name and name:lower()
            if lower and (lower:match("%.luau$") or lower:match("%.lua$") or lower:match("%.lua%.txt$"))
                and lower:find(query, 1, true) then
                filePaths[name] = path
                table.insert(matches, name)
            end
        end
        table.sort(matches)
        table.insert(matches, 1, noFile)
        fileDropdown:Set({Options = matches, CurrentOption = {selectedFile and filePaths[selectedFile] and selectedFile or noFile}})
        return #matches - 1
    end)
    if not ok then
        warn("[Mari Hub] File refresh: " .. tostring(result))
        pcall(notify, "Refresh failed", tostring(result))
    end
end

