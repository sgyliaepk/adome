local texturesCatalog = loadModule("TexturesDB")
local function showScan(house)
    local furnitureCount, furnitureCost, unknownFurniture = 0, 0, 0
    local textureCount, textureCost, unknownTextures = 0, 0, 0
    for _, item in pairs(house.furniture) do
        furnitureCount += 1
        local entry = catalog[item.id]
        if entry and type(entry.cost) == "number" and not entry.off_sale then
            furnitureCost += entry.cost
        else
            unknownFurniture += 1
        end
    end
    for _, room in pairs(house.textures or {}) do
        for kind, id in pairs(room) do
            textureCount += 1
            local entry = texturesCatalog[kind] and texturesCatalog[kind][id]
            if entry and type(entry.cost) == "number" then
                textureCost += entry.cost
            else
                unknownTextures += 1
            end
        end
    end
    scanType:Set("House type: " .. house.building_type)
    scanFurniture:Set(string.format("Furniture count: %d (%d Bucks listed, %d unpriced)", furnitureCount, furnitureCost, unknownFurniture))
    scanTextures:Set(string.format("Textures count: %d (%d Bucks listed, %d unpriced)", textureCount, textureCost, unknownTextures))
    scanProgress:Set("Scan progress: 100%")
end

