local function applyMariPalette()
    local coreGui = game:GetService("CoreGui")
    local root = type(gethui) == "function" and gethui() or coreGui
    local interface = root:FindFirstChild("Luna UI")
    if not interface then
        local robloxGui = coreGui:FindFirstChild("RobloxGui")
        interface = robloxGui and robloxGui:FindFirstChild("Luna UI")
    end
    local windowFrame = interface and interface:FindFirstChild("SmartWindow")
    if not windowFrame then return end

    local plum = Color3.fromRGB(37, 24, 54)
    local deepPlum = Color3.fromRGB(25, 17, 39)
    local lavender = Color3.fromRGB(190, 157, 255)
    local coral = Color3.fromRGB(255, 149, 133)
    local accents = ColorSequence.new(lavender, coral)

    windowFrame.BackgroundColor3 = plum
    windowFrame.Elements.BackgroundColor3 = deepPlum
    windowFrame.Title.Title.TextColor3 = Color3.fromRGB(255, 239, 250)
    windowFrame.Title.subtitle.TextColor3 = lavender
    for _, line in ipairs({windowFrame.Line, windowFrame.Navigation.Line}) do
        line.BackgroundColor3 = Color3.new(1, 1, 1)
        local gradient = line:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
        gradient.Color = accents
        gradient.Parent = line
    end
    for _, tabButton in ipairs(windowFrame.Navigation.Tabs:GetChildren()) do
        if tabButton:IsA("Frame") and tabButton.Name ~= "InActive Template" then
            tabButton.BackgroundColor3 = Color3.fromRGB(104, 69, 153)
        end
    end

    local pages = windowFrame.Elements.Interactions
    for _, action in ipairs({
        {pages["House Cloner"]["Place house"], coral, Color3.fromRGB(109, 49, 62)},
        {pages["File System"]["Save house to file"], lavender, Color3.fromRGB(75, 49, 116)},
    }) do
        local row = action[1]
        row.BackgroundColor3 = action[3]
        row.Title.TextColor3 = action[2]
        row.UIStroke.Color = action[2]
    end
end
