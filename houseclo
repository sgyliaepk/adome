        end
        task.wait(0.1)
    end
end)
-- Read house tables as data. Only the three layout constructors are accepted.
local function decode(sourceText)
    assert(#sourceText <= 8 * 1024 * 1024, "House file is too large")
    local position = 1
    local function token(pattern)
        local _, whitespaceEnd = sourceText:find("^%s*", position)
        position = whitespaceEnd + 1
        local first, last = sourceText:find("^" .. pattern, position)
        if first then
            position = last + 1
            return sourceText:sub(first, last)
        end
    end
    local function expect(pattern)
        local value = token(pattern)
        assert(value, "Invalid house file near byte " .. position)
        return value
    end
    local constructors = {
        ["Vector3.new"] = {Vector3.new, 3},
        ["Color3.new"] = {Color3.new, 3},
        ["CFrame.new"] = {CFrame.new, 12},
    }
    local parse
    parse = function(depth)
        assert(depth <= 64, "House file is nested too deeply")
        if token("{") then
            local value = {}
            local index = 1
            while not token("}") do
                local key
                if token("%[") then
                    key = parse(depth + 1)
                    expect("%]")
                    expect("=")
                else
                    local name = token("[%a_][%w_]*%s*=")
                    key = name and name:match("^[%w_]+") or index
                    if not name then index += 1 end
                end
                assert(type(key) == "string" or type(key) == "number", "Invalid table key")
                value[key] = parse(depth + 1)
                if not token("[,;]") then
                    expect("}")
                    break
                end
            end
            return value
        end
        local quote = token("[\"']")
        if quote then
            local first = position - 1
            while position <= #sourceText do
                local character = sourceText:sub(position, position)
                position += 1
                if character == quote then
                    local literal = sourceText:sub(first, position - 1)
                    return assert(loadstring("return " .. literal))()
                end
                if character == "\\" then position += 1 end
            end
            error("Unterminated string")
        end
        local numeric = token("[+-]?[%d%.][%d%.]*[eE]?[+-]?%d*")
        if numeric then
            local value = tonumber(numeric)
            assert(value and math.abs(value) < math.huge, "Invalid number")
            return value
        end
        local name = expect("[%a_][%w_%.]*")
        if name == "true" or name == "false" then return name == "true" end
        local constructor = assert(constructors[name], "Unsupported house field: " .. name)
        expect("%(")
        local arguments = {}
        for index = 1, constructor[2] do
            if index > 1 then expect(",") end
            local value = tonumber(expect("[+-]?[%d%.][%d%.]*[eE]?[+-]?%d*"))
            assert(value and math.abs(value) < math.huge, "Invalid constructor number")
            arguments[index] = value
        end
        expect("%)")
        return constructor[1](table.unpack(arguments))
    end
    expect("return%f[^%w_]")
    local house = parse(0)
    expect("$")
    assert(type(house) == "table" and type(house.building_type) == "string"
        and type(house.furniture) == "table", "File does not contain a house layout")
    return house
end

